generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER @map("customer")
  OWNER    @map("owner")
  ADMIN    @map("admin")

  @@map("user_role")
}

enum RestaurantStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  SUSPENDED @map("suspended")

  @@map("restaurant_status")
}

enum BookingStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  REJECTED   @map("rejected")
  CANCELLED  @map("cancelled")
  CHECKED_IN @map("checked_in")
  COMPLETED  @map("completed")
  NO_SHOW    @map("no_show")

  @@map("booking_status")
}

model Profile {
  // No FK to auth.users — Prisma only owns the public schema (Project rule 2).
  // id must equal the matching auth.users.id (Project rule 3); the row is
  // created by app code on sign-up, not a DB trigger.
  //
  // ไม่มี FK ไป auth.users — DB ไม่บังคับความสัมพันธ์นี้
  // ถ้าลบ user ใน Supabase Auth ต้องลบ Profile ด้วยในโค้ด
  // ไม่งั้นจะเหลือแถวกำพร้าที่ล็อกอินไม่ได้
  id        String   @id @db.Uuid
  email     String?
  role      Role     @default(CUSTOMER)
  fullName  String?  @map("full_name")
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedRestaurants    Restaurant[] @relation("RestaurantOwner")
  reviewedRestaurants Restaurant[] @relation("RestaurantReviewer")
  bookings            Booking[]

  @@map("profiles")
}

model Restaurant {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String           @map("owner_id") @db.Uuid
  owner        Profile          @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  address      String?
  phone        String?
  category     String
  coverImage   String?          @map("cover_image")
  status       RestaurantStatus @default(PENDING)
  rejectReason String?          @map("reject_reason")
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  reviewedBy   Profile?         @relation("RestaurantReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @map("created_at")

  bookings       Booking[]
  openingHours   OpeningHour[]
  bookingSetting BookingSetting?
  closures       Closure[]

  @@index([status])
  @@map("restaurants")
}

model Booking {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customerId   String        @map("customer_id") @db.Uuid
  customer     Profile       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingDate  DateTime      @map("booking_date") @db.Date
  slotTime     String        @map("slot_time")
  partySize    Int           @map("party_size")
  code         String        @unique
  customerNote String?       @map("customer_note")
  status       BookingStatus @default(PENDING)
  // Set on REJECTED (owner/admin) or CANCELLED (customer/admin) when a
  // reason is given; never cleared by a later transition — same rule as
  // Restaurant.rejectReason (Task 3).
  statusReason String?       @map("status_reason")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([restaurantId, bookingDate, slotTime])
  @@index([customerId, bookingDate])
  @@map("bookings")
}

model OpeningHour {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week")
  // String, not a time column — compared directly against Booking.slotTime
  // by the slot engine; a shared type avoids timezone conversion on every read.
  openTime     String     @map("open_time")
  closeTime    String     @map("close_time")
  isClosed     Boolean    @default(false) @map("is_closed")

  @@unique([restaurantId, dayOfWeek])
  @@map("opening_hours")
}

model BookingSetting {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String     @unique @map("restaurant_id") @db.Uuid
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  slotDuration    Int        @default(60) @map("slot_duration")
  capacityPerSlot Int        @default(40) @map("capacity_per_slot")
  maxPartySize    Int        @default(10) @map("max_party_size")
  advanceDays     Int        @default(30) @map("advance_days")
  minLeadHours    Int        @default(2) @map("min_lead_hours")
  autoConfirm     Boolean    @default(false) @map("auto_confirm")

  @@map("booking_settings")
}

model Closure {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  closedDate   DateTime   @map("closed_date") @db.Date
  reason       String?

  @@unique([restaurantId, closedDate])
  @@map("closures")
}
