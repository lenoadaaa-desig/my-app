generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER @map("customer")
  OWNER    @map("owner")
  ADMIN    @map("admin")

  @@map("user_role")
}

enum RestaurantStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  SUSPENDED @map("suspended")

  @@map("restaurant_status")
}

enum BookingStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  REJECTED   @map("rejected")
  CANCELLED  @map("cancelled")
  CHECKED_IN @map("checked_in")
  COMPLETED  @map("completed")
  NO_SHOW    @map("no_show")

  @@map("booking_status")
}

model Profile {
  // No FK to auth.users — Prisma only owns the public schema (Project rule 2).
  // id must equal the matching auth.users.id (Project rule 3); the row is
  // created by app code on sign-up, not a DB trigger.
  //
  // ไม่มี FK ไป auth.users — DB ไม่บังคับความสัมพันธ์นี้
  // ถ้าลบ user ใน Supabase Auth ต้องลบ Profile ด้วยในโค้ด
  // ไม่งั้นจะเหลือแถวกำพร้าที่ล็อกอินไม่ได้
  id        String   @id @db.Uuid
  // @unique since 2026-08-23 — a pair of rows shared demo-customer@example.com
  // for a week undetected (one from scripts/seed-demo.ts, one created by an
  // earlier magic-link browser test targeting the same email — Supabase
  // happily minted a new auth user for it since nothing there checks
  // `profiles` first). Postgres allows multiple NULLs under a unique
  // constraint (each NULL is distinct), so this doesn't block signups that
  // haven't set an email yet. If a future signup throws a unique-violation
  // here, don't just retry — it means an old orphaned/duplicate profile row
  // already holds that email; find and resolve it first (see CLAUDE.md's
  // "ปัญหาค้างที่ยังไม่แก้" note this replaced for how the original pair was
  // diagnosed and which one was kept).
  email     String?  @unique
  role      Role     @default(CUSTOMER)
  fullName  String?  @map("full_name")
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedRestaurants    Restaurant[] @relation("RestaurantOwner")
  reviewedRestaurants Restaurant[] @relation("RestaurantReviewer")
  bookings            Booking[]

  // Task 8 phase 2 (admin user list) — two different query shapes, measured
  // separately via EXPLAIN (ANALYZE, BUFFERS) against 2,500 synthetic rows,
  // not assumed:
  // - role alone (e.g. counting/filtering by role with no sort): role='X'
  //   used this index directly (Index Scan / Index Only Scan for the wider
  //   "owner" role, ~4 buffers) — the two columns are NOT redundant with
  //   each other, they serve different queries.
  // - the default paginated listing (WHERE role=X ORDER BY createdAt DESC
  //   LIMIT n): the planner used the createdAt index for an Index Scan
  //   Backward and applied role as a residual filter, skipping the role
  //   index entirely for this shape — before either index existed this was
  //   Seq Scan + a top-N heapsort (81-84 buffers); after, 20-25 buffers,
  //   ~9x faster, no sort step at all.
  @@index([role])
  @@index([createdAt])
  @@map("profiles")
}

model Restaurant {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String           @map("owner_id") @db.Uuid
  owner        Profile          @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  address      String?
  phone        String?
  category     String
  coverImage   String?          @map("cover_image")
  status       RestaurantStatus @default(PENDING)
  rejectReason String?          @map("reject_reason")
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  reviewedBy   Profile?         @relation("RestaurantReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @map("created_at")

  bookings       Booking[]
  openingHours   OpeningHour[]
  bookingSetting BookingSetting?
  closures       Closure[]

  @@index([status])
  // Postgres does not auto-index FK columns — confirmed via pg_indexes that
  // ownerId had none. Measured (EXPLAIN ANALYZE, 500 synthetic restaurants,
  // 20-id lookup — the admin user list's per-user "restaurants owned"
  // count, Task 8 phase 2): Seq Scan, 8 buffers -> Bitmap Heap/Index Scan,
  // 5 buffers. Smaller improvement than Profile's/Booking's indexes at this
  // row count (500 rows is cheap to seq-scan either way), kept anyway
  // because (a) this runs once per row of the admin user list, so it
  // compounds as the user count grows, and (b) a missing index on a FK
  // column makes deleting the referenced Profile slower (Postgres must
  // scan restaurants for rows pointing at it before the FK check can
  // clear it) — directly relevant to the delete-user feature this same
  // task adds.
  @@index([ownerId])
  @@map("restaurants")
}

model Booking {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customerId   String        @map("customer_id") @db.Uuid
  customer     Profile       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingDate  DateTime      @map("booking_date") @db.Date
  slotTime     String        @map("slot_time")
  partySize    Int           @map("party_size")
  code         String        @unique
  customerNote String?       @map("customer_note")
  status       BookingStatus @default(PENDING)
  // Set on REJECTED (owner/admin) or CANCELLED (customer/admin) when a
  // reason is given; never cleared by a later transition — same rule as
  // Restaurant.rejectReason (Task 3).
  statusReason String?       @map("status_reason")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([restaurantId, bookingDate, slotTime])
  @@index([customerId, bookingDate])
  // Task 9 phase 1 — checkBookingRateLimit (booking.service.ts) runs this
  // shape (WHERE customerId = ? AND createdAt >= ? ORDER BY createdAt LIMIT
  // 10) on every createBooking call, the hot path — (customerId, bookingDate)
  // above doesn't cover createdAt at all, so without this it'd fall back to
  // a per-customer scan ordered on the wrong column.
  @@index([customerId, createdAt])
  // Cross-restaurant aggregate filtered/grouped by date alone (the admin
  // dashboard's 30-day trend + no-show rate, Task 8 phase 2) — measured via
  // EXPLAIN (ANALYZE, BUFFERS) against 30,000 synthetic rows, not assumed.
  // Correction: an earlier version of this comment claimed the two indexes
  // above "don't help" this query at all — that was wrong. The planner DID
  // use (customerId, bookingDate) even though bookingDate isn't its
  // leading column, via an Index Cond that scans the whole index and
  // checks bookingDate on every entry rather than seeking directly to the
  // matching range: 2,121 buffers, 3.6ms, HashAggregate over Index Scan.
  // With this dedicated index: 6 buffers (~350x fewer), 0.8ms, GroupAggregate
  // over an Index Only Scan (no heap access at all). The old index worked,
  // just far less efficiently than a purpose-built one.
  @@index([bookingDate, status])
  @@map("bookings")
}

model OpeningHour {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week")
  // String, not a time column — compared directly against Booking.slotTime
  // by the slot engine; a shared type avoids timezone conversion on every read.
  openTime     String     @map("open_time")
  closeTime    String     @map("close_time")
  isClosed     Boolean    @default(false) @map("is_closed")

  @@unique([restaurantId, dayOfWeek])
  @@map("opening_hours")
}

model BookingSetting {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String     @unique @map("restaurant_id") @db.Uuid
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  slotDuration    Int        @default(60) @map("slot_duration")
  capacityPerSlot Int        @default(40) @map("capacity_per_slot")
  maxPartySize    Int        @default(10) @map("max_party_size")
  advanceDays     Int        @default(30) @map("advance_days")
  minLeadHours    Int        @default(2) @map("min_lead_hours")
  autoConfirm     Boolean    @default(false) @map("auto_confirm")

  @@map("booking_settings")
}

model Closure {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  closedDate   DateTime   @map("closed_date") @db.Date
  reason       String?

  @@unique([restaurantId, closedDate])
  @@map("closures")
}
